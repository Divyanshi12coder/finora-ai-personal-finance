# ---------------------------------------------------------------------------
# Finora - root environment file (used by docker compose)
#
#   cp .env.example .env
#
# For non-Docker local development, use backend/.env.example instead.
# ---------------------------------------------------------------------------

# --- PostgreSQL container --------------------------------------------------
POSTGRES_USER=finora
POSTGRES_PASSWORD=finora
POSTGRES_DB=finora
POSTGRES_PORT=5432

# --- Backend ---------------------------------------------------------------
BACKEND_PORT=8000
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-generate-a-long-random-string
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI provider (optional) ------------------------------------------------
# Leave AI_API_KEY empty to run entirely offline; the assistant then uses
# Finora's deterministic explainer over the same verified data.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5

# --- Frontend --------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api
