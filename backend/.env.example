# ---------------------------------------------------------------------------
# Finora backend configuration
#
# Copy to `.env` and fill in. Never commit the real `.env`.
#   cp backend/.env.example backend/.env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database (REQUIRED in production) -------------------------------------
# PostgreSQL is the supported target.
#   Local:  postgresql://finora:finora@localhost:5432/finora
#   Docker: postgresql://finora:finora@postgres:5432/finora
#
# If left empty, the backend falls back to a local SQLite file
# (backend/finora.db) so the project runs without installing PostgreSQL.
# That fallback is a development convenience only and is logged on startup.
DATABASE_URL=postgresql://finora:finora@localhost:5432/finora

# Set to true to echo every SQL statement (very noisy; debugging only).
SQL_ECHO=false

# --- Security (REQUIRED) ---------------------------------------------------
# Generate a strong value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app logs a warning on startup if this is left at its insecure default.
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Comma-separated list of allowed frontend origins. Never use "*" - the API is
# called with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- File uploads / OCR ----------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/jpg,image/webp,image/bmp,image/tiff

# Path to the Tesseract binary. Leave empty to discover it on PATH.
#   Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
#   macOS/Linux: usually already on PATH
# Receipt scanning is disabled (with a clear message) when Tesseract is absent;
# every other feature keeps working.
TESSERACT_CMD=
OCR_LANGUAGES=eng

# --- AI provider (OPTIONAL) ------------------------------------------------
# Without a key the assistant answers from the same verified backend data using
# a deterministic explainer - the figures are identical, the prose is plainer.
#
# AI_PROVIDER: anthropic | openai | openai-compatible
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-5
# Override only for a self-hosted or proxied endpoint.
AI_BASE_URL=
AI_MAX_TOKENS=900
AI_TIMEOUT_SECONDS=30

# --- Demo seed data --------------------------------------------------------
# Used by `python -m app.seed`.
DEMO_EMAIL=demo@finora.app
DEMO_PASSWORD=FinoraDemo123!
DEMO_NAME=Divyanshi
